    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jose": "^6.2.9",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
