    "rotate:keys": "tsx src/scripts/rotate-keys.ts",
    "seed:permits": "tsx src/scripts/seed-permits.ts",
    "seed:build": "tsx src/scripts/seed-build.ts",
    "seed:prices": "tsx src/scripts/seed-market-prices.ts",
    "check:embeddings": "tsx src/scripts/check-embeddings.ts",
    "refresh:prices": "tsx src/scripts/refresh-prices.ts",
    "check:repricing": "tsx src/scripts/check-repricing.ts",
    "check:estimate": "tsx src/scripts/check-estimate.ts",
    "encrypt:pii": "tsx src/scripts/encrypt-pii.ts",
    "migrate:inquiry-professional": "tsx src/scripts/migrate-inquiry-professional.ts",
