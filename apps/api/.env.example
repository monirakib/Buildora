# Copy to .env and adjust values.

PORT=4000

# Local MongoDB (via infra/docker-compose.yml) or a MongoDB Atlas connection string.
# Leave unset to boot the API without a database (health endpoint still works).
MONGODB_URI=mongodb://localhost:27017/buildora

# Signs access tokens. The API REFUSES TO START in production if this is left at
# a default or is shorter than 32 characters — a forgeable token secret is a
# total account takeover, so it fails loudly instead of running.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-in-production

# How long an access token lives. Short on purpose: it is held in the browser's
# memory and sent as a header, so what matters is how long a stolen one is worth
# something. The refresh cookie is what keeps someone signed in for a week.
ACCESS_TOKEN_TTL_MIN=15

# Ed25519 keys that SIGN access tokens, as JSON: {"k1":"<PKCS#8 PEM>"}.
# REQUIRED IN PRODUCTION. Signing is asymmetric now: only the private key here
# can mint a token, and the public half is published at /api/auth/jwks so
# anything else can verify without being able to forge. In development a
# throwaway pair is generated per boot (so restarts sign you out).
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('ed25519');console.log(JSON.stringify({k1:privateKey.export({type:'pkcs8',format:'pem'})}))"
# JWT_KEYRING={"k1":"-----BEGIN PRIVATE KEY-----\n..."}

# AES-256-GCM keys that ENCRYPT stored NID numbers and bank details, as JSON:
# {"k1":"<base64, exactly 32 bytes>"}.
#
# REQUIRED IN PRODUCTION, and deliberately not derived from JWT_SECRET: a
# derived key would mean rotating JWT_SECRET — an ordinary thing to do — made
# every encrypted field permanently unreadable.
#
# ** BACK THIS UP. Lose it and the encrypted data is gone; there is no recovery
# path, by design. ** In development a key is derived from JWT_SECRET so the app
# runs with no setup, which is also why changing JWT_SECRET locally orphans
# anything already encrypted.
#   node -e "console.log(JSON.stringify({k1:require('crypto').randomBytes(32).toString('base64')}))"
# DATA_KEYRING={"k1":"..."}
# DATA_KEY_ACTIVE=k1

# The blind-index and ledger-integrity keys. Both derive from the active data
# key under separate domain labels, so there is normally nothing to set.
#
# Note the blind-index key cannot be rotated online: changing it means
# recomputing every profile.nidKeyBlind from plaintext while the unique index
# must keep holding. Treat it as permanent.
# BLIND_INDEX_KEYRING={"v1":"..."}
# LEDGER_HMAC_KEYRING={"k1":"..."}
# LEDGER_KEY_ACTIVE=k1

# Refresh-token signing keys, as JSON: {"v1":"<base64, at least 32 bytes>"}.
# Optional — with this unset a key is derived from JWT_SECRET under a separate
# domain label, so there is nothing extra to configure to get started.
# REFRESH_HMAC_KEYRING={"v1":"..."}
# REFRESH_KEY_ACTIVE=v1

# Cookie policy for the refresh token. Unset, these follow NODE_ENV: SameSite
# Strict locally, None in production.
#
# None is not a weakening — it is the only value that works when the web app and
# this API are on different registrable domains, because a browser will not send
# a Strict or Lax cookie to a different site. A Strict cookie works perfectly on
# localhost and signs everyone out the moment it deploys. Set SESSION_COOKIE_-
# SAMESITE=strict only if both are served from one registrable domain, in which
# case also set SESSION_COOKIE_DOMAIN=.buildora.software so the cookie spans the
# api. subdomain.
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_DOMAIN=.buildora.software

# Password hashing cost (argon2id). The defaults are OWASP's 19 MiB / 2-pass /
# 1-lane configuration, sized for a 512 MB Render instance. Raising the memory
# is the strongest single change; existing hashes keep working and are upgraded
# to the new cost as people sign in.
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1

# A login ends after this many hours with no requests, and in any case this many
# hours after signing in. Lower them to test the timeout (e.g. 0.02 = ~1 minute).
SESSION_IDLE_HOURS=24
SESSION_MAX_HOURS=168

# Origins allowed to call this API, for HTTP and the socket. Comma-separated —
# the deployed site, a preview deployment, localhost against a live API. This is
# also the allowlist the CSRF guard checks the Origin header against, so keep it
# tight: with credentials enabled a wildcard is neither allowed nor safe.
CORS_ORIGIN=http://localhost:3000

# Where the browser lives, and where this API is reachable. SSLCommerz returns
# the payer to the API, which then redirects them into the web app.
#
# These three are the whole domain switch. Deployed, they become:
#   CORS_ORIGIN=https://buildora.software
#   WEB_BASE_URL=https://buildora.software
#   API_BASE_URL=https://api.buildora.software
# The payment gateway needs no separate registration — its success/fail/cancel
# and IPN URLs are built from API_BASE_URL per session. But a stale
# WEB_BASE_URL silently breaks every link in every email, since that is what
# they resolve against.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# SSLCommerz payment gateway — one hosted checkout fronting bKash, Nagad,
# Rocket, cards and internet banking. Register a free sandbox store at
# https://developer.sslcommerz.com; until these are set, every payment screen
# falls back to its manual "record a payment" form.
#
# Keep SSLCZ_SANDBOX=true unless you hold live merchant credentials — set it to
# false and real money moves.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true

# OpenStreetMap's Nominatim geocoder, behind the plot map picker. Free and
# keyless, but its usage policy wants a contact in the User-Agent identifying
# who is calling. Use a real email or repo URL — Nominatim returns 403 for
# placeholder domains such as example.com.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=buildora-cse471

# Open-Meteo — the weather stamped onto every site diary entry, plus the week
# ahead over the plot. No API key and no signup: leave these alone unless you
# need to point at a different host. Two hosts because they are separate
# services — the forecast API covers about the last 92 days plus 16 ahead, and
# the archive API serves anything older.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# Cloudinary — image and 3D model hosting (profile photos, certificates,
# portfolios, site diary photos). All three come from the Cloudinary dashboard;
# uploads return 503 until they are set. Note CLOUDINARY_CLOUD_NAME is the cloud
# name, not the API key's label.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini — the Buildora Guide assistant and the NID card pre-screen.
# Free key from https://aistudio.google.com; both features 503 without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq — fast Llama inference, paired with Gemini above as the platform's two
# free-tier AI providers (Buildora Guide, site diary digest, cost-estimate
# writeup). Groq answers first; if it rate-limits, the same call falls back to
# Gemini. Free key, no card, from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Web Push (VAPID). No account, no third party, no cost — the browser's own
# push service does the delivery and this keypair just proves the messages come
# from your server. Generate one pair and keep it: changing the public key
# invalidates every subscription already registered.
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: or https: URL — push services reject sends
# without it. Browser push is simply off until both keys are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@buildora.software

# Outgoing email — verification links, escrow releases, meeting confirmations.
# Two routes; the first one configured wins, in this order. Email is simply off
# until one of them is filled in.
#
# 1. Resend (https://resend.com > API keys, 3,000/month free) — the route
# production needs, because Render's free tier blocks outbound SMTP ports (25,
# 465, 587) and only HTTPS gets out. Add buildora.software under Domains and
# copy the DKIM/SPF/MX records it gives you into the registrar's DNS; sending
# starts the moment they resolve, with no account review in the way.
RESEND_API_KEY=
#
# 2. Gmail SMTP needs no third-party account, which makes it the local
# fallback — and unusable on Render, per the port block above. SMTP_PASSWORD is
# a 16-character *app password*, not the account password:
#   Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
#
# The From address. Resend accepts any address at a domain it has verified
# (no-reply@buildora.software); Gmail only accepts the account that
# authenticated and rewrites anything else. Set this to match whichever route
# above is live.
EMAIL_FROM_NAME=Buildora
EMAIL_FROM_ADDRESS=

# OpenRouteService — driving distance and ETA from a supplier's warehouse to the
# build site, with the road route drawn on the map. Free key from
# https://openrouteservice.org (2,000 requests/day). Delivery estimates are
# hidden until it's set.
ORS_API_KEY=

# WebRTC ICE servers for voice and video calls.
#
# STUN alone is enough between two ordinary home or office networks: it only
# tells each peer its own public address, and the media then flows directly.
#
# It is NOT enough on a mobile carrier. Bangladeshi mobile data sits behind
# carrier-grade NAT, which is usually symmetric — a different external port per
# destination — so the address STUN reports is useless to the other side and
# the call simply never connects. There is no error worth showing; it rings and
# then gives up. A TURN server fixes that by relaying the media.
#
# The Open Relay Project publishes a free TURN server with open credentials for
# exactly this, no signup and no card:
#   TURN_URL=turn:openrelay.metered.ca:80
#   TURN_USERNAME=openrelayproject
#   TURN_CREDENTIAL=openrelayproject
# It is a shared public relay, so treat it as a demo-grade fallback rather than
# something to depend on. Unset, calls still work — just not phone-to-laptop
# over mobile data.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# The supervisor account created by `pnpm seed:admin`. Without an email and
# password the seed script does nothing. Holds the whole admin console,
# including key rotation at /api/keys/* (see services/rotation.ts).
ADMIN_NAME=Platform Supervisor
ADMIN_USERNAME=supervisor
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Comma-separated DNS servers, e.g. 1.1.1.1,8.8.8.8. Only needed on networks
# where Node can't resolve a mongodb+srv SRV record with the system resolver.
DNS_SERVERS=
