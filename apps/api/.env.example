# Copy to .env and adjust values.

PORT=4000

# Local MongoDB (via infra/docker-compose.yml) or a MongoDB Atlas connection string.
# Leave unset to boot the API without a database (health endpoint still works).
MONGODB_URI=mongodb://localhost:27017/buildora

JWT_SECRET=change-me-in-production
# Keep this at least as long as SESSION_MAX_HOURS.
JWT_EXPIRES_IN=7d

# A login ends after this many hours with no requests, and in any case this many
# hours after signing in. Lower them to test the timeout (e.g. 0.02 = ~1 minute).
SESSION_IDLE_HOURS=24
SESSION_MAX_HOURS=168

CORS_ORIGIN=http://localhost:3000

# Where the browser lives, and where this API is reachable. SSLCommerz returns
# the payer to the API, which then redirects them into the web app.
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# SSLCommerz payment gateway — one hosted checkout fronting bKash, Nagad,
# Rocket, cards and internet banking. Register a free sandbox store at
# https://developer.sslcommerz.com; until these are set, every payment screen
# falls back to its manual "record a payment" form.
#
# Keep SSLCZ_SANDBOX=true unless you hold live merchant credentials — set it to
# false and real money moves.
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=true

# OpenStreetMap's Nominatim geocoder, behind the plot map picker. Free and
# keyless, but its usage policy wants a contact in the User-Agent identifying
# who is calling. Use a real email or repo URL — Nominatim returns 403 for
# placeholder domains such as example.com.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_CONTACT=buildora-cse471
