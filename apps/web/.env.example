# Copy to .env.local and adjust values.
# Only NEXT_PUBLIC_ vars belong here, and every one of them is readable by
# anyone who opens devtools. API keys go in apps/api/.env, never in this file.

NEXT_PUBLIC_API_URL=http://localhost:4000

# The origin this deployment is served from, absolute and without a trailing
# slash. Link previews, the sitemap and robots.txt are read by crawlers on
# someone else's machine, so a relative URL is useless to them.
#
# Unset, it falls back to Vercel's own NEXT_PUBLIC_VERCEL_URL (preview
# deployments) and then to localhost. Getting it wrong doesn't error — it just
# ships share cards pointing at the wrong host.
#   NEXT_PUBLIC_SITE_URL=https://buildora.software
NEXT_PUBLIC_SITE_URL=http://localhost:3000
